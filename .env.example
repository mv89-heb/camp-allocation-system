# PostgreSQL / Neon connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Required for public deployments. Leave empty only for local development.
ADMIN_TOKEN=replace-with-a-long-random-secret

# Comma-separated hostnames. Use your Render domain and custom domain in production.
ALLOWED_HOSTS=*

LOG_LEVEL=INFO
MAX_ANALYZE_ROWS=5000
