# PostgreSQL / Neon connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Required for manager/admin API access in public deployments.
ADMIN_TOKEN=replace-with-a-long-random-admin-secret

# Required for the dedicated mobile field-reporting screen.
# Use a separate secret from ADMIN_TOKEN.
FIELD_TOKEN=replace-with-a-long-random-field-secret

# Comma-separated hostnames. Use your Render domain and custom domain in production.
ALLOWED_HOSTS=*

LOG_LEVEL=INFO
MAX_ANALYZE_ROWS=5000
